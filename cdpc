#!/bin/bash

ME=`whoami`

CDPC_DIR=/usr/local/cdpc
CDPC_WATCH=/tmp/cdpcd_watch
CDPC_LOADINFO=/tmp/cdpcd-load.log
CDPC_LOGDIR="$CDPC_DIR/logs"
CDPC_UAUTH="$CDPC_DIR/uauth"

if [ "$UID" -gt 0 ] ; then

    if [[ ! -d "$CDPC_DIR/uauth" ]] || [ ! -f "$CDPC_DIR/uauth/$ME" ] ; then
        echo "没有被授权，普通用户无法使用cdpc管理服务。（You are not authorized.）"
        exit 1
    fi

    CDPC_DIR="$HOME/.local/cdpc"
    CDPC_WATCH="$CDPC_DIR/watch"
    CDPC_LOADINFO="$CDPC_DIR/cdpcd-load.log"
    CDPC_LOGDIR="$CDPC_DIR/logs"
fi

if [ ! -d "$CDPC_DIR" ] ; then
    mkdir -p "$CDPC_DIR"
fi

CDPC_CONFIG="$CDPC_DIR/config"

if [ ! -d "$CDPC_CONFIG" ] ; then
    mkdir -p $CDPC_CONFIG
fi

if [ ! -d "$CDPC_LOGDIR" ] ; then
    mkdir -p "$CDPC_LOGDIR"
fi

if [ ! -d "$CDPC_WATCH" ] ; then
    mkdir -p $CDPC_WATCH
fi

CDPC_SERVER="$CDPC_DIR/webserver"

CDPC_SERVER_APP="$CDPC_SERVER/app.js"

ARGS=''

help () {
    if [ -f "/usr/local/cdpc/helpdoc" ] ; then
        man "/usr/local/cdpc/helpdoc"
    fi
}

parse_args () {
    if [ "$#" -gt 0 ] ; then
        
        COUNT=0

        for a in $@ ; do
            let COUNT+=1
            if [ $COUNT -gt 1 ] ; then
                ARGS="$ARGS $a"
            fi
        done

    fi
}

check_args2_exit () {
    if [ "$1" -lt $2 ] ; then
        echo "less arguments."
        exit 1
    fi
}

handle_config () {
    case $1 in
        add)
            if [ ! -f "$2" ] ; then
                echo "$2 : file not exists"
                exit 1
            fi

            cp "$2" "$CDPC_CONFIG/"
            echo "$CDPC_CONFIG/$2" > "$CDPC_WATCH/load"
            ;;

        remove)
            if [ ! -f "$CDPC_CONFIG/$2" ] ; then
                echo "file not exists"
                exit 1
            fi
            rm "$CDPC_CONFIG/$2"
            ;;
        list)
            CFGLIST=`ls $CDPC_CONFIG`
            for c in $CFGLIST ; do
                echo $c
            done
            ;;
        show)
            CFGLIST=`ls $CDPC_CONFIG`
            for c in $CFGLIST ; do
                echo "$CDPC_CONFIG/$c:"
                cat -n "$CDPC_CONFIG/$c"
                echo "    "
            done
            ;;
    esac
}

out_app_state() {
    __CHECK_COUNT=0
    _CUR_STATE_FILE="$CDPC_WATCH/state/$2"
    #按照预期的结果进行检测
    case $1 in
        start|resume)
            while sleep 0.15 ; do
                let __CHECK_COUNT+=1
                if [ -f "$_CUR_STATE_FILE" ] ; then
                    APP_STATE_TEXT=`cat $_CUR_STATE_FILE`
                    MATCH_STATE=`echo $APP_STATE_TEXT | grep '^running'`
                    if [ -n "$MATCH_STATE" ] ; then
                        echo "$2 $APP_STATE_TEXT"
                        break
                    fi
                fi

                if [ "$__CHECK_COUNT" -gt 99 ] ; then
                    break
                fi
            done
            ;;
        restart)
          while sleep 0.1 ; do
              let __CHECK_COUNT+=1
              if [ -f "$_CUR_STATE_FILE" ] ; then
                APP_STATE_TEXT=`cat $_CUR_STATE_FILE`
                MATCH_STATE=`cat $_CUR_STATE_FILE | grep '^exit'`
                if [ -n "$MATCH_STATE" ] ; then
                  echo "$2 $APP_STATE_TEXT"
                  break
                fi
              fi

              if [ "$__CHECK_COUNT" -gt 99 ] ; then
                break
              fi
          done
          
          let __CHECK_COUNT=0

          while sleep 0.1 ; do
              let __CHECK_COUNT+=1
              if [ -f "$_CUR_STATE_FILE" ] ; then
                APP_STATE_TEXT=`cat $_CUR_STATE_FILE`
                MATCH_STATE=`cat $_CUR_STATE_FILE | grep '^running'`
                if [ -n "$MATCH_STATE" ] ; then
                  echo "$2 $APP_STATE_TEXT"
                  break
                fi
              fi

              if [ "$__CHECK_COUNT" -gt 123 ] ; then
                break
              fi
          done
          ;;
        stop)
            while sleep 0.15 ; do
                let __CHECK_COUNT+=1
                if [ -f "$_CUR_STATE_FILE" ] ; then
                    APP_STATE_TEXT=`cat $_CUR_STATE_FILE`
                    MATCH_STATE=`echo $APP_STATE_TEXT | grep '^exit'`
                    if [ -n "$MATCH_STATE" ] ; then
                        echo "$2 stoped"
                        break
                    fi
                fi

                if [ "$__CHECK_COUNT" -gt 99 ] ; then
                    break
                fi
            done
            ;;

        remove)
            while sleep 0.15 ; do
                let __CHECK_COUNT+=1
                if [ ! -f "$_CUR_STATE_FILE" ] ; then
                    echo "$2 removed"
                    break
                fi

                if [ "$__CHECK_COUNT" -gt 99 ] ; then
                    break
                fi
            done
            ;;
    esac
}

handle_app () {
    for a in $ARGS ; do
        date > $CDPC_WATCH/$1/$a
    done

    for a in $ARGS ; do
        out_app_state $1 $a
    done
}

handle_webserver () {
    case $1 in
        start)
            ;;

        stop)
            ;;

        restart)
            ;;

        pause)
            ;;
        
        resume)
            ;;
        *)
            echo "$1 : unknow command"
            return 1
            ;;
    esac

    echo cdpcd-web-server > $CDPC_WATCH/$1/cdpcd-web-server
}

handle_auth () {
    case $1 in
        add)
            ;;

        remove)
            ;;
        *)
            echo "unknow command"
            exit 1
            ;;
    esac

    node /usr/local/cdpc/auth.js $1 $2
}

load_config () {
    echo $1 > $CDPC_WATCH/load
}

clear_logs () {
    LOGFILES=`ls $CDPC_LOGDIR`
    for f in $LOGFILES ; do
        if [ ! "$f" = "cdpcd.log" ] ; then
            rm "$CDPC_LOGDIR/$f"
        fi
    done
}

handle_log () {
    case $1 in
        clear)
            clear_logs
            ;;
        clearall)
            clear_logs
            > "$CDPC_LOGDIR/cdpcd.log"
            ;;
    esac
}

parse_args $@

case $1 in
    start)
        check_args2_exit $# 2
        handle_app start $ARGS
        ;;

    stop)
        check_args2_exit $# 2
        handle_app stop $ARGS
        ;;

    restart)
        check_args2_exit $# 2
        handle_app restart $ARGS
        ;;

    pause)
        check_args2_exit $# 2
        handle_app pause $ARGS
        ;;

    resume)
        check_args2_exit $# 2
        handle_app resume $ARGS
        ;;

    reload)
        date > $CDPC_WATCH/reload
        ;;

    remove)
        check_args2_exit $# 2
        handle_app remove $ARGS
        ;;

    load)
        if [ "$#" -lt 2 ] ; then
            load_config $CDPC_CONFIG
        else
            load_config $CDPC_CONFIG/$2
        fi
        ;;

    log)
        if [ "$#" -lt 2 ] ; then
            if [ -d "$CDPC_LOGDIR" ] ; then
                LOGFILES=`ls $CDPC_LOGDIR | sort`
                for f in $LOGFILES ; do
                    echo "$f:"
                    cat "$CDPC_LOGDIR/$f" -b
                done
            fi
            exit 0
        fi

        handle_log $2
        ;;

    status)
        node /usr/local/cdpc/outstatus.js $CDPC_LOADINFO
        if [ "$UID" -eq 0 ] ; then
            if [ -d "$CDPC_UAUTH" ] ; then
                UAULIST=`ls $CDPC_UAUTH`
                UCDPCD_LOAD=''
                for u in $UAULIST ; do
                    echo "------ $u ------:"
                    UHOMEDIR=`cat $CDPC_UAUTH/$u`
                    UCDPCD_LOAD="$UHOMEDIR/.local/cdpc/cdpcd-load.log"
                    if [ -f "$UCDPCD_LOAD" ] ; then
                        node /usr/local/cdpc/outstatus.js $UCDPCD_LOAD
                    fi
                done
            fi
        fi
        ;;
    
    #start stop restart
    webserver)
        check_args2_exit $# 2
        if [ "$UID" -gt 0 ] ; then
            echo "deny!!"
            exit 1
        fi

        handle_webserver $2
        ;;

    config)
        if [[ $# -gt 1 ]] && [[ "$2" = "show" ]] ; then
            handle_config show
            exit 0
        fi

        check_args2_exit $# 3
        handle_config $2 $3
        ;;

    #用户授权
    auth)
        if [[ $# -lt 2 ]] && [[ "$UID" -gt 0 ]] ; then
            if [ ! -f "/usr/local/cdpc/uauth/$ME" ] ; then
                echo "!!还没有被授权(You are not authorized.)"
            else
                echo "已被授权(You have be authorized.)"
            fi

            exit 0
        fi

        if [ "$UID" -gt 0 ] ; then
            echo "deny!!"
            exit 1
        fi

        if [ $# -lt 2 ] ; then
            UAUTH_PATH="/usr/local/cdpc/uauth"

            if [ ! -d "$UAUTH_PATH" ] ; then
                echo 'There is no user auth.'
            else
                ls $UAUTH_PATH
            fi

            exit 0
        fi

        check_args2_exit $# 3

        #[add|remove] [USER]
        handle_auth $2 $3
        ;;

    help)
        help
        ;;
    
    *)
        printf "\x1b[2;36m使用cdpc help查看帮助文档\n\x1b[0m"
        echo "快速使用提示："
        echo "  cdpc status 查看应用状态"
        echo "  cdpc config add [文件路径] 添加配置文件"
        echo "  cdpc config show 显示配置文件详情"
        echo "  cdpc config remove [配置文件名称] 移除配置文件"
        echo "  cdpc start  [应用名称] 启动应用"
        echo "  cdpc stop   [应用名称] 停止应用"
        echo "  cdpc pause  [应用名称] 暂停应用"
        echo "  cdpc resume  [应用名称] 恢复暂停的应用"
        echo "  cdpc restart [应用名称] 重启应用"
        echo "  cdpc auth 查看自己是否被授权/查看授权信息"
        echo "示例："
        echo "  cdpc stop --all"
        echo "  cdpc restart app1 app2"

        exit 0
        ;;
esac
