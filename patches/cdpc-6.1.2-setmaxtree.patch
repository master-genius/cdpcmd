+  /**
+   * 设定进程树明细列表的上限（静态方法，不挂在原型上：它改的是模块级变量，
+   * 对本进程内所有 CDPC 实例一起生效，跟某个实例无关）。
+   *
+   * 改完立即生效，不需要重建实例——下一次采集进程树时读的就是新值。
+   *
+   * 注意它只影响"逐进程列出多少个"：整棵子树一直是完整遍历的，
+   * cpuTotal / memTotal / procCount 按 pid 逐个求和，不受此值影响。
+   * 调大的代价是每次采集多读同样数量的 /proc/<pid>/cmdline。
+   *
+   * 参数非法时**抛出**而不是静默忽略：这是启动期的配置调用，调用方写错了
+   * 就该当场知道；悄悄用回默认值正是最难查的那种失效。
+   *
+   * @param {number} n 允许范围 [10, 10000] 的整数
+   * @returns {number} 生效后的值
+   * @throws {TypeError} n 不是有限整数
+   * @throws {RangeError} n 超出允许范围
+   */
+  static setMaxTree(n) {
+    if (typeof n !== 'number' || !Number.isFinite(n)) {
+      throw new TypeError(`setMaxTree: 需要一个数字，收到 ${typeof n}: ${n}`)
+    }
+
+    if (!Number.isInteger(n)) {
+      throw new TypeError(`setMaxTree: 需要整数，收到 ${n}`)
+    }
+
+    if (n < TREE_PROC_LIMIT_MIN || n > TREE_PROC_LIMIT_MAX) {
+      throw new RangeError(
+        `setMaxTree: 允许范围 [${TREE_PROC_LIMIT_MIN}, ${TREE_PROC_LIMIT_MAX}]，收到 ${n}`)
+    }
+
+    TREE_PROC_LIMIT = n
+
+    return TREE_PROC_LIMIT
+  }
