#!/bin/bash

is_systemd() {
    IS_SYSTEMD=`ps -e -o ppid,pid,comm | grep -E -i '^\s*0\s+1\s+systemd'`
    if [ -n "$IS_SYSTEMD" ] ; then
        return 0
    fi

    return 1
}

ME=`whoami`

CDPC_INS_DIR=/usr/local/cdpc
CDPC_DIR=/usr/local/cdpc
CDPC_WATCH=/tmp/cdpcd_watch
CDPC_LOADINFO=/tmp/cdpcd-load.log
CDPC_LOGDIR="$CDPC_DIR/logs"
CDPC_UAUTH="$CDPC_DIR/uauth"

SUDO=''

if [ "$EUID" -ne 0 ] ; then
    SUDO='sudo'
fi

if [ "$UID" -gt 0 ] ; then

    if [[ ! -d "$CDPC_DIR/uauth" ]] || [ ! -f "$CDPC_DIR/uauth/$ME" ] ; then
        echo "没有被授权，普通用户无法使用cdpc管理服务。（You are not authorized.）"
        exit 1
    fi

    CDPC_DIR="$HOME/.cdpc"
    CDPC_WATCH="$CDPC_DIR/watch"
    CDPC_LOADINFO="$CDPC_DIR/cdpcd-load.log"
    CDPC_LOGDIR="$CDPC_DIR/logs"
fi

if [ ! -d "$CDPC_DIR" ] ; then
    mkdir -p "$CDPC_DIR"
fi

CDPC_CONFIG="$CDPC_DIR/config"
CDPC_DISABLED_DIR="$CDPC_CONFIG/disabled"

if [ ! -d "$CDPC_CONFIG" ] ; then
    mkdir -p $CDPC_CONFIG
fi

if [ ! -d "$CDPC_LOGDIR" ] ; then
    mkdir -p "$CDPC_LOGDIR"
fi

if [ ! -d "$CDPC_WATCH" ] ; then
    mkdir -p $CDPC_WATCH
fi

if [ ! -d "$CDPC_DISABLED_DIR" ] ; then
    mkdir -p $CDPC_DISABLED_DIR
fi

CDPC_SERVER="$CDPC_DIR/webserver"

CDPC_SERVER_APP="$CDPC_SERVER/app.js"

ARGS=''

help () {
    if [ -f "/usr/local/cdpc/helpdoc" ] ; then
        man "/usr/local/cdpc/helpdoc"
    fi
}

parse_args () {
    if [ "$#" -gt 0 ] ; then 
        COUNT=0
        for a in $@ ; do
            let COUNT+=1
            if [ $COUNT -gt 1 ] ; then
                ARGS="$ARGS $a"
            fi
        done
    fi
}

check_args2_exit () {
    if [ "$1" -lt $2 ] ; then
        echo "less arguments."
        exit 1
    fi
}

# 校验配置文件名：去扩展名后必须符合 cdpc 的 name 规则
# （字母/数字/下划线开头，仅含字母数字下划线减号及 @，长度不超过 50）。
# cdpc 用配置文件名作为服务名，所以文件名必须合法。
check_config_filename() {
    local fname base
    fname=$(basename "$1")
    base="$fname"
    case "$base" in
        *.js)   base="${base%.js}" ;;
        *.cjs)  base="${base%.cjs}" ;;
        *.mjs)  base="${base%.mjs}" ;;
        *.json) base="${base%.json}" ;;
    esac

    if [[ "$base" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_@-]{0,49}$ ]] ; then
        return 0
    fi

    return 1
}

handle_config () {
    case $1 in
        add)
            if [ ! -f "$2" ] ; then
                echo "$2 : file not exists"
                exit 1
            fi

            if ! check_config_filename "$2" ; then
                echo "配置文件名不合法：$(basename "$2")"
                echo "cdpc 用配置文件名作为服务名，文件名（去扩展名后）必须："
                echo "  · 以字母、数字或下划线开头"
                echo "  · 仅包含字母、数字、下划线、减号、@"
                echo "  · 长度不超过 50"
                exit 1
            fi

            CFG_BASENAME=$(basename "$2")
            cp "$2" "$CDPC_CONFIG/"
            echo "$CDPC_CONFIG/$CFG_BASENAME" > "$CDPC_WATCH/load"
            ;;

        remove)
            if [ ! -f "$CDPC_CONFIG/$2" ] ; then
                echo "file not exists"
                exit 1
            fi
            rm "$CDPC_CONFIG/$2"
            ;;
        list)
            CFGLIST=`ls $CDPC_CONFIG`
            for c in $CFGLIST ; do
                echo $c
            done
            ;;
        show)
            CFGLIST=`ls $CDPC_CONFIG`
            for c in $CFGLIST ; do
                echo "$CDPC_CONFIG/$c:"
                cat -n "$CDPC_CONFIG/$c"
                echo "    "
            done
            ;;
        errors)
            CFG_ERR_FILE="$CDPC_LOGDIR/config-errors.log"
            if [ -f "$CFG_ERR_FILE" ] ; then
                cat "$CFG_ERR_FILE"
            else
                echo "暂无配置加载报告（服务尚未加载过配置，或没有 config-errors.log）。"
            fi
            ;;
    esac
}

check_has_app() {
    __HAS_COUNT=0
    _APP_STATE_DIR="$CDPC_WATCH/state"
    _APP_STATE_FILE="$_APP_STATE_DIR/$1"
    
    if [ ! -d "$_APP_STATE_DIR" ] ; then
        return 1
    fi

    if [ ! -f "$_APP_STATE_FILE" ] ; then
        echo "$1 not found!!"
        return 1
    fi

    return 0
}

real_remove_file() {
    if [ -f "$1" ] ; then
        rm $1
    fi
}

remove_file_delay() {
    sleep 0.05 && real_remove_file $1
}

# 通过has子命令查找是否存在应用。
# 只有超级用户才可以获取所有的应用状态并指定其他用户身份控制应用。
handle_app() {
    LIMIT_USER_ARGS=''
    if [ $EUID -ne 0 ] ; then
        LIMIT_USER_ARGS=" --limit-user $USER"
    fi

    HAS_RESULT=`$0 has-name $ARGS`

    if [ -z "$HAS_RESULT" ] ; then
        echo "$ARGS not found!" | awk '{$1=$1};1'
        exit 1
    fi

    for a in $HAS_RESULT; do
        MAP_NAME_CMD_FILE=`node $CDPC_INS_DIR/mapnametocmd.js $a -op $1`

        node $CDPC_INS_DIR/noticeApp.js $MAP_NAME_CMD_FILE
        if [ "$EUID" -eq 0 ] ; then
            #删除文件，避免问题
            if [ -f "$MAP_NAME_CMD_FILE" ] ; then
                remove_file_delay $MAP_NAME_CMD_FILE &
            fi
        fi
    done

    case $1 in
        disable)
            node $CDPC_INS_DIR/disable-or-enable.js disable $HAS_RESULT
            ;;

        enable)
            node $CDPC_INS_DIR/disable-or-enable.js enable $HAS_RESULT
            ;;
    esac

    node $CDPC_INS_DIR/get_app_state.js $1 $HAS_RESULT
}

handle_webserver() {
    case $1 in
        start)
            ;;

        stop)
            ;;

        restart)
            ;;

        pause)
            ;;
        
        resume)
            ;;
        *)
            echo "$1 : unknow command"
            return 1
            ;;
    esac

    echo cdpcd-web-server > $CDPC_WATCH/$1/cdpcd-web-server
}

handle_auth() {
    case $1 in
        add)
            ;;

        remove)
            ;;

        show)
            ;;

        *)
            echo "unknow command"
            exit 1
            ;;
    esac

    node /usr/local/cdpc/auth.js $ARGS
}

load_config() {
    echo $1 > $CDPC_WATCH/load
}

clear_logs() {
    LOGFILES=`ls $CDPC_LOGDIR`
    for f in $LOGFILES ; do
        if [ "$f" = "cdpcd.log" ] ; then
            continue
        fi
        if [ -f "$CDPC_LOGDIR/$f" ] ; then
            rm "$CDPC_LOGDIR/$f"
        fi
    done
    # 应用日志在 logs/apps/ 子目录：cdpcd 持有写入流，用 truncate 清空而非 rm，
    # 保证正在写入的流不失效。
    if [ -d "$CDPC_LOGDIR/apps" ] ; then
        for af in "$CDPC_LOGDIR"/apps/* ; do
            [ -f "$af" ] && : > "$af"
        done
    fi
}

parse_args $@

# 命令审计：变更类操作追加一行到 audit.log
write_audit() {
    AUDIT_FILE="$CDPC_LOGDIR/audit.log"
    AUDIT_TS=`date '+%Y-%m-%d %H:%M:%S'`
    echo "$AUDIT_TS | $ME | $@" >> "$AUDIT_FILE" 2>/dev/null
}

case $1 in
    start|stop|restart|pause|resume|remove|safe-remove|disable|enable|reload|load|config|auth|webserver|service-start|service-stop|service-restart)
        write_audit "$@"
        ;;
esac

case $1 in
    start)
        check_args2_exit $# 2
        handle_app start $ARGS
        ;;

    stop)
        check_args2_exit $# 2
        handle_app stop $ARGS
        ;;

    restart)
        check_args2_exit $# 2
        handle_app restart $ARGS
        ;;

    pause)
        check_args2_exit $# 2
        handle_app pause $ARGS
        ;;

    resume)
        check_args2_exit $# 2
        handle_app resume $ARGS
        ;;

    reload)
        date > $CDPC_WATCH/reload
        ;;

    remove)
        check_args2_exit $# 2
        handle_app remove $ARGS
        ;;

    safe-remove)
        check_args2_exit $# 2
        handle_app safeRemove $ARGS
        ;;

    disable)
        check_args2_exit $# 2
        handle_app disable $ARGS
        ;;

    enable)
        check_args2_exit $# 2
        handle_app enable $ARGS
        ;;

    load)
        if [ "$#" -lt 2 ] ; then
            load_config $CDPC_CONFIG
        else
            load_config $CDPC_CONFIG/$2
        fi
        ;;

    log)
        # 解析 flag 参数
        LOG_CLEAR=0
        LOG_CLEARALL=0
        LOG_TARGET=''
        LOG_FOLLOW=0
        shift
        while [ $# -gt 0 ] ; do
            case "$1" in
                --clear)
                    LOG_CLEAR=1
                    ;;
                --clear-all)
                    LOG_CLEARALL=1
                    ;;
                -f)
                    LOG_FOLLOW=1
                    ;;
                *)
                    LOG_TARGET="$1"
                    ;;
            esac
            shift
        done

        # --clear / --clear-all
        if [ "$LOG_CLEARALL" -eq 1 ] ; then
            clear_logs
            > "$CDPC_LOGDIR/cdpcd.log"
            exit 0
        elif [ "$LOG_CLEAR" -eq 1 ] ; then
            clear_logs
            exit 0
        fi

        # 无目标：显示 cdpcd 自身日志
        if [ -z "$LOG_TARGET" ] ; then
            if [ -d "$CDPC_LOGDIR" ] ; then
                LOGFILES=`ls $CDPC_LOGDIR | sort`
                for f in $LOGFILES ; do
                    if [ ! -f "$CDPC_LOGDIR/$f" ] ; then
                        continue
                    fi
                    echo "$f:"
                    cat "$CDPC_LOGDIR/$f" -b
                done
            fi
            exit 0
        fi

        # 指定应用名：查看应用日志
        LOG_NAME="$LOG_TARGET"
        case "$LOG_NAME" in
            *:*)
                LOG_USER="${LOG_NAME%%:*}"
                LOG_APP="${LOG_NAME#*:}"
                ;;
            *)
                LOG_USER=""
                LOG_APP="$LOG_NAME"
                ;;
        esac

        if [ -z "$LOG_USER" ] || [ "$LOG_USER" = "root" ] ; then
            LOG_FILE="$CDPC_LOGDIR/apps/$LOG_APP.log"
        else
            if [ "$UID" -ne 0 ] ; then
                echo "deny!! 普通用户只能查看自己的服务。"
                exit 1
            fi
            UHOME=`cat "$CDPC_UAUTH/$LOG_USER" 2>/dev/null`
            if [ -z "$UHOME" ] ; then
                echo "$LOG_USER : 未授权用户"
                exit 1
            fi
            LOG_FILE="$UHOME/.cdpc/logs/apps/$LOG_APP.log"
        fi

        if [ ! -f "$LOG_FILE" ] ; then
            echo "未找到应用日志：$LOG_FILE"
            exit 1
        fi

        if [ "$LOG_FOLLOW" -eq 1 ] ; then
            tail -f "$LOG_FILE"
        else
            tail -n 200 "$LOG_FILE"
        fi
        ;;

    args)
      echo $ARGS
      ;;

    has-name)
        STATUS_TEXT_RESULT=`$0 status --has --encode-json $ARGS`

        node $CDPC_INS_DIR/combine-status-result.js $STATUS_TEXT_RESULT --only-name
        ;;

    has-encode)
        STATUS_TEXT_RESULT=`$0 status --has --encode-json $ARGS`

        node $CDPC_INS_DIR/combine-status-result.js $STATUS_TEXT_RESULT --encode-json
        ;;

    has)
        STATUS_TEXT_RESULT=`$0 status --has --encode-json $ARGS`

        node $CDPC_INS_DIR/combine-status-result.js $STATUS_TEXT_RESULT
        ;;

    status)
        # 检测 --runtime：若存在则收集所有 (user, loadfile) 对，单进程进入 TUI 主循环
        if echo " $ARGS " | grep -qE -- ' --runtime(=| )' ; then
            RUNTIME_TARGETS=""
            if [ -f "$CDPC_LOADINFO" ] ; then
                RUNTIME_TARGETS="$USER	$CDPC_LOADINFO"
            fi
            if [ "$UID" -eq 0 ] && [ -d "$CDPC_UAUTH" ] ; then
                for u in `ls $CDPC_UAUTH` ; do
                    UHOMEDIR=`cat $CDPC_UAUTH/$u`
                    UCDPCD_LOAD="$UHOMEDIR/.cdpc/cdpcd-load.log"
                    if [ -f "$UCDPCD_LOAD" ] ; then
                        if [ -z "$RUNTIME_TARGETS" ] ; then
                            RUNTIME_TARGETS="$u	$UCDPCD_LOAD"
                        else
                            RUNTIME_TARGETS="$RUNTIME_TARGETS
$u	$UCDPCD_LOAD"
                        fi
                    fi
                done
            fi
            if [ -n "$RUNTIME_TARGETS" ] ; then
                CDPC_RUNTIME_TARGETS="$RUNTIME_TARGETS" node $CDPC_INS_DIR/runstatus.js $ARGS
            fi
        else
            if [ -f "$CDPC_LOADINFO" ] ; then
                node $CDPC_INS_DIR/outstatus.js $CDPC_LOADINFO $ARGS --user $USER
            fi
            if [ "$UID" -eq 0 ] ; then
                if [ -d "$CDPC_UAUTH" ] ; then
                    UAULIST=`ls $CDPC_UAUTH`
                    UCDPCD_LOAD=''
                    for u in $UAULIST ; do
                        UHOMEDIR=`cat $CDPC_UAUTH/$u`
                        UCDPCD_LOAD="$UHOMEDIR/.cdpc/cdpcd-load.log"
                        if [ -f "$UCDPCD_LOAD" ] ; then
                            node $CDPC_INS_DIR/outstatus.js $UCDPCD_LOAD $ARGS --user $u
                        fi
                    done
                fi
            fi
        fi
        ;;

    has-app)
        for a in $ARGS ; do
            if check_has_app $a ; then
                echo "has $a"
            fi
        done
        ;;

    #查看某个服务的完整运行时配置
    inspect)
        check_args2_exit $# 2
        INSPECT_NAME="$2"
        case "$INSPECT_NAME" in
            *:*)
                INSPECT_USER="${INSPECT_NAME%%:*}"
                INSPECT_APP="${INSPECT_NAME#*:}"
                ;;
            *)
                INSPECT_USER=""
                INSPECT_APP="$INSPECT_NAME"
                ;;
        esac

        if [ -z "$INSPECT_USER" ] || [ "$INSPECT_USER" = "root" ] ; then
            if [ -f "$CDPC_LOADINFO" ] ; then
                node $CDPC_INS_DIR/inspect.js "$CDPC_LOADINFO" "$INSPECT_APP"
            else
                echo "未找到负载信息文件，服务可能未运行。"
            fi
        else
            if [ "$UID" -ne 0 ] ; then
                echo "deny!! 普通用户只能查看自己的服务。"
                exit 1
            fi
            UHOME=`cat "$CDPC_UAUTH/$INSPECT_USER" 2>/dev/null`
            if [ -z "$UHOME" ] ; then
                echo "$INSPECT_USER : 未授权用户"
                exit 1
            fi
            ULOAD="$UHOME/.cdpc/cdpcd-load.log"
            if [ -f "$ULOAD" ] ; then
                node $CDPC_INS_DIR/inspect.js "$ULOAD" "$INSPECT_APP"
            else
                echo "未找到 $INSPECT_USER 的负载信息文件。"
            fi
        fi
        ;;

    #查看某个服务的 stdout/stderr 输出日志（兼容旧命令，等价于 cdpc log <name>）
    applog)
        # 将 applog 参数重组后委托给 log 命令处理
        NEW_ARGS=''
        APPLOG_FOLLOW=0
        shift
        while [ $# -gt 0 ] ; do
            case "$1" in
                -f)
                    APPLOG_FOLLOW=1
                    ;;
                *)
                    NEW_ARGS="$NEW_ARGS $1"
                    ;;
            esac
            shift
        done
        $0 log $NEW_ARGS $([ "$APPLOG_FOLLOW" -eq 1 ] && echo '-f')
        ;;

    #查看命令审计日志
    audit)
        AUDIT_VIEW_FILE="$CDPC_LOGDIR/audit.log"
        if [ -f "$AUDIT_VIEW_FILE" ] ; then
            tail -n 100 "$AUDIT_VIEW_FILE"
        else
            echo "暂无审计日志。"
        fi
        ;;
    
    #start stop restart
    webserver)
        check_args2_exit $# 2
        if [ "$UID" -gt 0 ] ; then
            echo "deny!!"
            exit 1
        fi

        handle_webserver $2
        ;;

    config)
        # 无参子命令：show / errors / list
        if [[ $# -gt 1 ]] ; then
            case $2 in
                show|errors|list)
                    handle_config $2
                    exit 0
                    ;;
            esac
        fi

        check_args2_exit $# 3
        handle_config $2 $3
        ;;

    #用户授权
    auth)
        if [[ $# -lt 2 ]] && [[ "$UID" -gt 0 ]] ; then
            if [ ! -f "/usr/local/cdpc/uauth/$ME" ] ; then
                echo "!!还没有被授权(You are not authorized.)"
            else
                echo "已被授权(You have be authorized.)"
            fi

            exit 0
        fi

        if [ "$UID" -gt 0 ] ; then
            echo "deny!!"
            exit 1
        fi

        if [ $# -lt 2 ] ; then
            UAUTH_PATH="/usr/local/cdpc/uauth"

            if [ ! -d "$UAUTH_PATH" ] ; then
                echo 'There is no user auth.'
            else
                ls $UAUTH_PATH
            fi

            exit 0
        fi

        #check_args2_exit $# 3

        #[add|remove] [USER]
        handle_auth $ARGS
        ;;

    help)
        help
        ;;
    
    'service-stop')
        if is_systemd ; then
            $SUDO systemctl stop cdpcd.service
        else
            $SUDO /etc/init.d/cdpc stop
        fi
        ;;

    'service-start')
        if is_systemd ; then
            $SUDO systemctl start cdpcd.service
        else
            $SUDO /etc/init.d/cdpc start
        fi
        ;;

    'service-restart')
        if is_systemd ; then
            $SUDO systemctl restart cdpcd.service
        else
            $SUDO /etc/init.d/cdpc restart
        fi
        ;;

    *)
        printf "\x1b[2;36m使用cdpc help查看帮助文档\n\x1b[0m"
        echo "快速使用提示："
        echo "  cdpc status 查看应用状态"
        echo "  cdpc inspect [应用名称] 查看服务完整运行时配置"
        echo "  cdpc config add [文件路径] 添加配置文件"
        echo "  cdpc config show 显示配置文件详情"
        echo "  cdpc config errors 查看最近一次配置加载报告"
        echo "  cdpc config remove [配置文件名称] 移除配置文件"
        echo "  cdpc start  [应用名称] 启动应用"
        echo "  cdpc stop   [应用名称] 停止应用"
        echo "  cdpc pause  [应用名称] 暂停应用"
        echo "  cdpc resume  [应用名称] 恢复暂停的应用"
        echo "  cdpc restart [应用名称] 重启应用"
        echo "  cdpc log [应用名称] 查看应用日志（-f 持续跟踪，--clear 清理日志，--clear-all 清理全部含cdpcd日志）"
        echo "  cdpc auth 查看自己是否被授权/查看授权信息"
        echo "  cdpc service-start 启动cdpcd服务"
        echo "  cdpc service-stop 停止cdpcd服务"
        echo "  cdpc service-restart 重启cdpcd服务"
        echo "示例："
        echo "  cdpc stop --all"
        echo "  cdpc restart app1 app2"

        exit 0
        ;;
esac
