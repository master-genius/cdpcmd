#!/bin/bash

is_systemd() {
    IS_SYSTEMD=`ps -e -o ppid,pid,comm | grep -E -i '^\s*0\s+1\s+systemd'`
    if [ -n "$IS_SYSTEMD" ] ; then
        return 0
    fi

    return 1
}

ME=`whoami`

# 空环境（cron、systemd）下 HOME 可能不存在，兜底按当前身份取 passwd 记录，
# 否则 CDPC_DIR 会退化成 /.cdpc。
if [ -z "$HOME" ] ; then
    HOME=`getent passwd "$ME" | cut -d: -f6`
    export HOME
fi

CDPC_INS_DIR=/usr/local/cdpc
CDPC_DIR=/usr/local/cdpc
CDPC_LOGDIR="$CDPC_DIR/logs"
CDPC_UAUTH="$CDPC_DIR/uauth"

# sock 是唯一的控制通道（文件通道已从 cdpc 库移除）。
# 路径推导只有一份实现：lib/sockpath.js，daemon 与 CLI 共用。
# 惰性求值：不需要通道的命令（help / config list / log 等）不付这次 node 启动开销。
CDPC_SOCK=''

ensure_sock() {
    if [ -z "$CDPC_SOCK" ] ; then
        CDPC_SOCK=`node $CDPC_INS_DIR/socketpath.js`
    fi
}

SUDO=''

if [ "$EUID" -ne 0 ] ; then
    SUDO='sudo'
fi

if [ "$UID" -gt 0 ] ; then

    if [[ ! -d "$CDPC_DIR/uauth" ]] || [ ! -f "$CDPC_DIR/uauth/$ME" ] ; then
        echo "没有被授权，普通用户无法使用cdpc管理服务。（You are not authorized.）"
        exit 1
    fi

    CDPC_DIR="$HOME/.cdpc"
    CDPC_LOGDIR="$CDPC_DIR/logs"
fi

if [ ! -d "$CDPC_DIR" ] ; then
    mkdir -p "$CDPC_DIR"
fi

CDPC_CONFIG="$CDPC_DIR/config"
CDPC_DISABLED_DIR="$CDPC_CONFIG/disabled"

if [ ! -d "$CDPC_CONFIG" ] ; then
    mkdir -p $CDPC_CONFIG
fi

if [ ! -d "$CDPC_LOGDIR" ] ; then
    mkdir -p "$CDPC_LOGDIR"
fi

if [ ! -d "$CDPC_DISABLED_DIR" ] ; then
    mkdir -p $CDPC_DISABLED_DIR
fi



ARGS=''

help () {
    if [ -f "/usr/local/cdpc/helpdoc" ] ; then
        man "/usr/local/cdpc/helpdoc"
    fi
}

parse_args () {
    if [ "$#" -gt 0 ] ; then 
        COUNT=0
        for a in $@ ; do
            let COUNT+=1
            if [ $COUNT -gt 1 ] ; then
                ARGS="$ARGS $a"
            fi
        done
    fi
}

check_args2_exit () {
    if [ "$1" -lt $2 ] ; then
        echo "less arguments."
        exit 1
    fi
}

# 校验配置文件名：去扩展名后必须符合 cdpc 的 name 规则
# （字母/数字/下划线开头，仅含字母数字下划线减号及 @，长度不超过 50）。
# cdpc 用配置文件名作为服务名，所以文件名必须合法。
check_config_filename() {
    local fname base
    fname=$(basename "$1")
    base="$fname"
    case "$base" in
        *.js)   base="${base%.js}" ;;
        *.cjs)  base="${base%.cjs}" ;;
        *.mjs)  base="${base%.mjs}" ;;
        *.json) base="${base%.json}" ;;
    esac

    if [[ "$base" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_@-]{0,49}$ ]] ; then
        return 0
    fi

    return 1
}

handle_config () {
    case $1 in
        add)
            if [ ! -f "$2" ] ; then
                echo "$2 : file not exists"
                exit 1
            fi

            if ! check_config_filename "$2" ; then
                echo "配置文件名不合法：$(basename "$2")"
                echo "cdpc 用配置文件名作为服务名，文件名（去扩展名后）必须："
                echo "  · 以字母、数字或下划线开头"
                echo "  · 仅包含字母、数字、下划线、减号、@"
                echo "  · 长度不超过 50"
                exit 1
            fi

            if ! precheck_config_file "$2" ; then
                exit 1
            fi

            CFG_BASENAME=$(basename "$2")
            cp "$2" "$CDPC_CONFIG/"

            CFG_REPORT_BEFORE=`report_mtime`
            if ! node $CDPC_INS_DIR/sockop.js load --path "$CDPC_CONFIG/$CFG_BASENAME" ; then
                exit 1
            fi

            if ! wait_config_report "$CFG_REPORT_BEFORE" "$CDPC_CONFIG/$CFG_BASENAME" ; then
                echo ""
                echo "该配置已被 cdpcd 拒绝，服务未加载（文件仍在 $CDPC_CONFIG/$CFG_BASENAME，改好后 cdpc reload）。"
                exit 1
            fi
            ;;

        remove)
            if [ ! -f "$CDPC_CONFIG/$2" ] ; then
                echo "file not exists"
                exit 1
            fi
            rm "$CDPC_CONFIG/$2"
            ;;
        list)
            CFGLIST=`ls $CDPC_CONFIG`
            for c in $CFGLIST ; do
                echo $c
            done
            ;;
        show)
            CFGLIST=`ls $CDPC_CONFIG`
            for c in $CFGLIST ; do
                echo "$CDPC_CONFIG/$c:"
                cat -n "$CDPC_CONFIG/$c"
                echo "    "
            done
            ;;
        errors)
            CFG_ERR_FILE="$CDPC_LOGDIR/config-errors.log"
            if [ -f "$CFG_ERR_FILE" ] ; then
                cat "$CFG_ERR_FILE"
            else
                echo "暂无配置加载报告（服务尚未加载过配置，或没有 config-errors.log）。"
            fi
            ;;

        *)
            # 原先未知子命令静默退出，用户无从判断是打错了还是没生效
            echo "config: 未知子命令 '$1'"
            echo "可用: add <file> | remove <file> | list | show | errors"
            exit 1
            ;;
    esac
}

# 服务是否存在：改走 sock has 查询（原实现读 watch/state/<name> 文件）
check_has_app() {
    ensure_sock

    # outstatus 在 --has 模式下用退出码 3 表示"cdpcd 不可达"，
    # 与"服务不存在"（退出码 0 + 空输出）区分开，避免 daemon 一挂就报 not found。
    __HAS_RESULT=`node $CDPC_INS_DIR/outstatus.js "$CDPC_SOCK" --has "$1" 2>/dev/null`
    __HAS_CODE=$?

    if [ "$__HAS_CODE" -eq 3 ] ; then
        node $CDPC_INS_DIR/socketpath.js --check
        echo "无法确认 $1 是否存在：cdpcd 不可达。"
        return 1
    fi

    if [ -z "$__HAS_RESULT" ] ; then
        echo "$1 not found!!"
        return 1
    fi

    return 0
}

# 普通用户不得以 user:name 形式指定他人的服务。
# 必须在 has 查询之前拦下：否则会先去自己的 daemon 查找，
# 把"越权"表现成"服务不存在"，掩盖真实原因。
check_target_owner() {
    if [ "$EUID" -eq 0 ] ; then
        return 0
    fi

    for _a in $@ ; do
        case "$_a" in
            *:*)
                _TU="${_a%%:*}"
                if [ "$_TU" != "$ME" ] ; then
                    echo "deny!! 普通用户只能操作自己的服务（$_a）"
                    exit 1
                fi
                ;;
        esac
    done

    return 0
}

# 通过has子命令查找是否存在应用。
# 只有超级用户才可以获取所有的应用状态并指定其他用户身份控制应用。
handle_app() {
    LIMIT_USER_ARGS=''
    if [ $EUID -ne 0 ] ; then
        LIMIT_USER_ARGS=" --limit-user $ME"
    fi

    check_target_owner $ARGS

    HAS_RESULT=`$0 has-name $ARGS 2>/dev/null`

    if [ -z "$HAS_RESULT" ] ; then
        # C3 根治：查不到时必须区分"cdpcd 不可达"与"服务确实不存在"，
        # 否则 daemon 一挂，所有操作都报成 "not found"，与服务本身无关。
        #
        # 探活范围要贴合本次目标：全部目标都带 user: 前缀时只查这些用户，
        # 否则（裸名字或 --all）需要在所有 daemon 里找，任一不可达都是"无法确认"。
        CHECK_USERS=''
        CHECK_ALL=0

        for _a in $ARGS ; do
            case "$_a" in
                *:*)
                    _TU="${_a%%:*}"
                    # 只接受合法用户名字符：CHECK_USERS 后面要经过一次
                    # 不带引号的词展开（需要按空格拆成多个参数），
                    # 过滤掉通配符与空白可以杜绝 glob 展开等意外
                    case "$_TU" in
                        ''|*[!a-zA-Z0-9_@.-]*) CHECK_ALL=1 ;;
                        *) CHECK_USERS="$CHECK_USERS $_TU" ;;
                    esac
                    ;;
                *)   CHECK_ALL=1 ;;
            esac
        done

        if [ "$CHECK_ALL" -eq 1 ] ; then
            UNREACHABLE=`node $CDPC_INS_DIR/socketpath.js --check`
        else
            UNREACHABLE=`node $CDPC_INS_DIR/socketpath.js --check $CHECK_USERS`
        fi

        if [ -n "$UNREACHABLE" ] ; then
            echo "$UNREACHABLE"
            echo "无法确认服务是否存在：上述 cdpcd 不可达。"
            exit 1
        fi

        echo "$ARGS not found!" | awk '{$1=$1};1'
        exit 1
    fi

    # disabled 标记文件（磁盘配置持久化，与通信无关）仍由本脚本维护
    case $1 in
        disable)
            node $CDPC_INS_DIR/disable-or-enable.js disable $HAS_RESULT
            ;;

        enable)
            node $CDPC_INS_DIR/disable-or-enable.js enable $HAS_RESULT
            ;;
    esac

    # 命令下发 + 完成确认合并到 sockop.js（替代 mapnametocmd + noticeApp + get_app_state）
    node $CDPC_INS_DIR/sockop.js $1 $HAS_RESULT
}

handle_auth() {
    case $1 in
        add)
            ;;

        remove)
            ;;

        show)
            ;;

        *)
            echo "unknow command"
            exit 1
            ;;
    esac

    node /usr/local/cdpc/auth.js $ARGS
}

load_config() {
    CFG_REPORT_BEFORE=`report_mtime`
    node $CDPC_INS_DIR/sockop.js load --path "$1" || return 1
    wait_config_report "$CFG_REPORT_BEFORE"
}

# 配置文件预检：语法错误应当在 cp 进配置目录之前就报出来。
# 原流程是先 cp 再异步 load，写错的配置已经落进配置目录，daemon 每次
# reload 都会再拒一次，而用户只看到一句"load 已受理"。
# 这里只做**语法检查**（node --check / JSON.parse），不执行配置文件本身。
precheck_config_file() {
    local f="$1"

    # cdpcd 扫描配置目录时只认 .js 与 .json（cdpc 库里按后缀硬匹配）。
    # .cjs/.mjs 能通过文件名合法性校验，却永远不会被加载——加进去之后
    # "已受理"照打、服务却始终不存在，正是最难查的那种静默失败。
    case "$f" in
        *.cjs|*.mjs)
            echo "cdpcd 只加载 .js 与 .json 配置，不会扫描 $(basename "$f")。"
            echo "请把它改名为 .js 后再添加。"
            return 1
            ;;
    esac

    case "$f" in
        *.js)
            if ! node --check "$f" ; then
                echo "配置文件语法错误，已中止添加：$f"
                return 1
            fi
            ;;
        *.json)
            if ! node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$f" ; then
                echo "配置文件不是合法 JSON，已中止添加：$f"
                return 1
            fi
            ;;
    esac

    return 0
}

CFG_REPORT="$CDPC_LOGDIR/config-errors.log"

report_mtime() {
    stat -c '%y' "$CFG_REPORT" 2>/dev/null || echo none
}

# load / reload 是**异步受理**：sockop 打印"已受理"时 daemon 还没解析完配置。
# 不等这份报告，配置被拒对用户就是完全静默的。等到报告刷新即回显。
#
# 退出码语义（脚本会依赖它）：
#   1 = 本次关心的配置**确实被拒**；0 = 没被拒，或没能在超时内拿到报告。
#   超时只是"没等到证据"，不是失败——否则 daemon 一忙，部署脚本里的
#   cdpc reload 就会开始无故报错。
#
# $1 = 调用前的报告 mtime
# $2 = 可选，只关心报告中提到该路径/名字的错误行；不给则看总的 skipped 计数
wait_config_report() {
    local before="$1"
    local only="$2"
    local i=0
    local now skipped hit

    while [ $i -lt 40 ] ; do
        now=`report_mtime`

        if [ "$now" != "$before" ] ; then
            echo ""
            echo "── 配置加载报告 ──"
            cat "$CFG_REPORT"

            if [ -n "$only" ] ; then
                # 只判定本次这个文件：配置目录里早就存在的其他坏配置
                # 不该让本次 add 报失败。
                hit=`grep -F -- "$only" "$CFG_REPORT" 2>/dev/null | grep '^! '`
                [ -n "$hit" ] && return 1
                return 0
            fi

            skipped=`sed -n 's/.*skipped: \([0-9][0-9]*\).*/\1/p' "$CFG_REPORT" | head -n 1`
            if [ -n "$skipped" ] && [ "$skipped" -gt 0 ] ; then
                return 1
            fi

            return 0
        fi

        sleep 0.1
        i=$((i+1))
    done

    echo "（未在 4 秒内等到配置加载报告，稍后用 cdpc config errors 查看；cdpcd 可能未运行）"
    return 0
}

# `cdpc log <名字>` 查不到日志、或日志里只有事件行没有实际输出时的降级诊断。
# 用户此刻要的是"为什么没有输出"，而不是一句 not found 就退出。
log_diagnose() {
    local name="$1"
    local logbase="$2"
    local appname="$3"
    local hit

    echo ""
    echo "── 诊断 ──"

    hit=`$0 has-name "$name" 2>/dev/null`
    if [ -z "$hit" ] ; then
        echo "· cdpcd 中不存在服务 $name —— 配置未加载 / 名字写错 / cdpcd 不可达"
    else
        echo "· cdpcd 中存在该服务；运行时状态与 cause 见： cdpc inspect $name"
    fi

    if [ -f "$logbase/config-errors.log" ] ; then
        # -A 1：报告里错误行的下一行才是具体原因，只抓标题行等于没说
        hit=`grep -n -A 1 -F -- "$appname" "$logbase/config-errors.log" 2>/dev/null`
        if [ -n "$hit" ] ; then
            echo "· 配置加载报告中提到了它（$logbase/config-errors.log）："
            echo "$hit" | sed 's/^/    /'
        else
            echo "· 配置加载报告未提到它，报告头部："
            head -n 2 "$logbase/config-errors.log" | sed 's/^/    /'
        fi
    else
        echo "· 没有配置加载报告，cdpcd 尚未加载过配置：$logbase/config-errors.log"
    fi

    if [ -f "$logbase/cdpcd.log" ] ; then
        hit=`tail -n 2000 "$logbase/cdpcd.log" | grep -F -- "$appname" | tail -n 20`
        if [ -n "$hit" ] ; then
            echo "· cdpcd 日志中的相关记录："
            echo "$hit" | sed 's/^/    /'
        else
            echo "· cdpcd 日志中没有与 $appname 相关的记录：$logbase/cdpcd.log"
        fi
    fi

    echo "· 还可以看： cdpc status $name  /  cdpc config errors  /  cdpc log（不带名字，看 cdpcd 全部日志）"
}

clear_logs() {
    LOGFILES=`ls $CDPC_LOGDIR`
    for f in $LOGFILES ; do
        # 这三个不是"日志"而是排障凭据，清日志不该把它们一起抹掉：
        #   cdpcd.log         —— 由 --clear-all 单独处理
        #   config-errors.log —— 当前配置状态的快照，删掉要等下次 load 才重建
        #   audit.log         —— 变更审计，清日志顺手清审计是说不通的
        case "$f" in
            cdpcd.log|config-errors.log|audit.log) continue ;;
        esac
        if [ -f "$CDPC_LOGDIR/$f" ] ; then
            rm "$CDPC_LOGDIR/$f"
        fi
    done
    # 应用日志在 logs/apps/ 子目录：cdpcd 持有写入流，用 truncate 清空而非 rm，
    # 保证正在写入的流不失效。
    if [ -d "$CDPC_LOGDIR/apps" ] ; then
        for af in "$CDPC_LOGDIR"/apps/* ; do
            [ -f "$af" ] && : > "$af"
        done
    fi
}

parse_args $@

# 命令审计：变更类操作追加一行到 audit.log
write_audit() {
    AUDIT_FILE="$CDPC_LOGDIR/audit.log"
    AUDIT_TS=`date '+%Y-%m-%d %H:%M:%S'`
    echo "$AUDIT_TS | $ME | $@" >> "$AUDIT_FILE" 2>/dev/null
}

case $1 in
    start|stop|restart|pause|resume|remove|safe-remove|disable|enable|reload|reload-force|load|config|auth|service-start|service-stop|service-restart)
        write_audit "$@"
        ;;
esac

case $1 in
    start)
        check_args2_exit $# 2
        handle_app start $ARGS
        ;;

    stop)
        check_args2_exit $# 2
        handle_app stop $ARGS
        ;;

    restart)
        check_args2_exit $# 2
        handle_app restart $ARGS
        ;;

    pause)
        check_args2_exit $# 2
        handle_app pause $ARGS
        ;;

    resume)
        check_args2_exit $# 2
        handle_app resume $ARGS
        ;;

    reload)
        CFG_REPORT_BEFORE=`report_mtime`
        node $CDPC_INS_DIR/sockop.js reload && wait_config_report "$CFG_REPORT_BEFORE"
        ;;

    # 强制重载：停止服务并按配置文件重建它。
    # reload 只按 command/args 指纹判断变化，env/options/cgroup 这类只在
    # spawn 时被读的字段改了之后 reload 与 restart 都不会生效（见 helpdoc）。
    reload-force)
        check_args2_exit $# 2

        # 必须显式点名。--all 等同于逐个重启全部服务，与一次手滑的代价
        # 完全不成比例，因此在展开成服务列表之前就挡掉。
        for _a in $ARGS ; do
            if [ "$_a" = "--all" ] ; then
                echo "reload-force 必须显式指定服务名，不支持 --all。"
                exit 1
            fi
        done

        handle_app reloadForce $ARGS
        ;;

    remove)
        check_args2_exit $# 2
        handle_app remove $ARGS
        ;;

    safe-remove)
        check_args2_exit $# 2
        handle_app safeRemove $ARGS
        ;;

    disable)
        check_args2_exit $# 2
        handle_app disable $ARGS
        ;;

    enable)
        check_args2_exit $# 2
        handle_app enable $ARGS
        ;;

    load)
        if [ "$#" -lt 2 ] ; then
            load_config $CDPC_CONFIG
        else
            load_config $CDPC_CONFIG/$2
        fi
        ;;

    log)
        # 解析 flag 参数
        LOG_CLEAR=0
        LOG_CLEARALL=0
        LOG_TARGET=''
        LOG_FOLLOW=0
        shift
        while [ $# -gt 0 ] ; do
            case "$1" in
                --clear)
                    LOG_CLEAR=1
                    ;;
                --clear-all)
                    LOG_CLEARALL=1
                    ;;
                -f)
                    LOG_FOLLOW=1
                    ;;
                *)
                    LOG_TARGET="$1"
                    ;;
            esac
            shift
        done

        # --clear / --clear-all
        if [ "$LOG_CLEARALL" -eq 1 ] ; then
            clear_logs
            > "$CDPC_LOGDIR/cdpcd.log"
            exit 0
        elif [ "$LOG_CLEAR" -eq 1 ] ; then
            clear_logs
            exit 0
        fi

        # 无目标：显示 cdpcd 自身日志
        if [ -z "$LOG_TARGET" ] ; then
            if [ -d "$CDPC_LOGDIR" ] ; then
                LOGFILES=`ls $CDPC_LOGDIR | sort`
                for f in $LOGFILES ; do
                    if [ ! -f "$CDPC_LOGDIR/$f" ] ; then
                        continue
                    fi
                    echo "$f:"
                    cat "$CDPC_LOGDIR/$f" -b
                done
            fi
            exit 0
        fi

        # 指定应用名：查看应用日志
        LOG_NAME="$LOG_TARGET"
        case "$LOG_NAME" in
            *:*)
                LOG_USER="${LOG_NAME%%:*}"
                LOG_APP="${LOG_NAME#*:}"
                ;;
            *)
                LOG_USER=""
                LOG_APP="$LOG_NAME"
                ;;
        esac

        # LOG_BASEDIR 是该目标 daemon 的 logs 目录：诊断要读的 cdpcd.log 与
        # config-errors.log 都在这里，root 看他人服务时必须跟着切过去。
        if [ -z "$LOG_USER" ] || [ "$LOG_USER" = "root" ] ; then
            LOG_BASEDIR="$CDPC_LOGDIR"
        else
            if [ "$UID" -ne 0 ] ; then
                echo "deny!! 普通用户只能查看自己的服务。"
                exit 1
            fi
            UHOME=`cat "$CDPC_UAUTH/$LOG_USER" 2>/dev/null`
            if [ -z "$UHOME" ] ; then
                echo "$LOG_USER : 未授权用户"
                exit 1
            fi
            LOG_BASEDIR="$UHOME/.cdpc/logs"
        fi

        LOG_FILE="$LOG_BASEDIR/apps/$LOG_APP.log"

        if [ ! -f "$LOG_FILE" ] ; then
            echo "未找到应用日志：$LOG_FILE"
            log_diagnose "$LOG_NAME" "$LOG_BASEDIR" "$LOG_APP"
            exit 1
        fi

        if [ "$LOG_FOLLOW" -eq 1 ] ; then
            # 跟踪模式先给出诊断，再进入 tail -f：
            # 卡在 tail -f 上什么都不出现时，上面这段就是唯一的线索。
            log_diagnose "$LOG_NAME" "$LOG_BASEDIR" "$LOG_APP"
            echo ""
            echo "── $LOG_FILE ──"
            tail -f "$LOG_FILE"
        else
            tail -n 200 "$LOG_FILE"

            # 日志里只有 cdpcd 写的事件行（== 启动/退出、!! 失败），
            # 说明服务根本没产生输出 —— 这正是用户说"看不到有效信息"的场景，
            # 自动补上诊断，不用他再去猜该看哪个文件。
            LOG_BODY=`grep -c -v -E '^(==|!!|=====|[[:space:]]*$)' "$LOG_FILE" 2>/dev/null`
            if [ -z "$LOG_BODY" ] || [ "$LOG_BODY" -eq 0 ] ; then
                log_diagnose "$LOG_NAME" "$LOG_BASEDIR" "$LOG_APP"
            fi
        fi
        ;;

    args)
      echo $ARGS
      ;;

    has-name)
        STATUS_TEXT_RESULT=`$0 status --has --encode-json $ARGS`

        node $CDPC_INS_DIR/combine-status-result.js $STATUS_TEXT_RESULT --only-name
        ;;

    has-encode)
        STATUS_TEXT_RESULT=`$0 status --has --encode-json $ARGS`

        node $CDPC_INS_DIR/combine-status-result.js $STATUS_TEXT_RESULT --encode-json
        ;;

    has)
        STATUS_TEXT_RESULT=`$0 status --has --encode-json $ARGS`

        node $CDPC_INS_DIR/combine-status-result.js $STATUS_TEXT_RESULT
        ;;

    status)
        # 目标枚举统一由 socketpath.js 完成（root: 自己 + 全部授权用户；普通用户: 仅自己）。
        # 原实现用 `if [ -f "$载入文件" ]` 静默跳过不可用目标——这正是 status
        # 一片空白的病根之一；现在不可用目标由 outstatus/runstatus 明确标注。
        STATUS_TARGETS=`node $CDPC_INS_DIR/socketpath.js --targets`

        if echo " $ARGS " | grep -qE -- ' --runtime(=| )' ; then
            if [ -n "$STATUS_TARGETS" ] ; then
                CDPC_RUNTIME_TARGETS="$STATUS_TARGETS" node $CDPC_INS_DIR/runstatus.js $ARGS
            else
                echo "没有可用的 cdpcd 目标（未授权或路径推导失败）。"
                exit 1
            fi
        else
            echo "$STATUS_TARGETS" | while IFS="	" read -r STU STSOCK ; do
                [ -z "$STSOCK" ] && continue
                node $CDPC_INS_DIR/outstatus.js "$STSOCK" $ARGS --user "$STU"
            done
        fi
        ;;

    has-app)
        for a in $ARGS ; do
            if check_has_app $a ; then
                echo "has $a"
            fi
        done
        ;;

    #查看某个服务的完整运行时配置
    inspect)
        check_args2_exit $# 2
        INSPECT_NAME="$2"
        case "$INSPECT_NAME" in
            *:*)
                INSPECT_USER="${INSPECT_NAME%%:*}"
                INSPECT_APP="${INSPECT_NAME#*:}"
                ;;
            *)
                INSPECT_USER=""
                INSPECT_APP="$INSPECT_NAME"
                ;;
        esac

        if [ -z "$INSPECT_USER" ] ; then
            ensure_sock
            node $CDPC_INS_DIR/inspect.js "$CDPC_SOCK" "$INSPECT_APP"
        else
            # 归属判断统一交给 socketpath.js（含越权拒绝与 uauth 记录校验）：
            # 不能在此对 "root" 开特例，否则普通用户指定 root: 会落到自己的 sock，
            # 把越权表现成"服务不存在"。
            INSPECT_SOCK=`node $CDPC_INS_DIR/socketpath.js --user "$INSPECT_USER"` || exit 1
            node $CDPC_INS_DIR/inspect.js "$INSPECT_SOCK" "$INSPECT_APP"
        fi
        ;;

    #查看某个服务的 stdout/stderr 输出日志（兼容旧命令，等价于 cdpc log <name>）
    applog)
        # 将 applog 参数重组后委托给 log 命令处理
        NEW_ARGS=''
        APPLOG_FOLLOW=0
        shift
        while [ $# -gt 0 ] ; do
            case "$1" in
                -f)
                    APPLOG_FOLLOW=1
                    ;;
                *)
                    NEW_ARGS="$NEW_ARGS $1"
                    ;;
            esac
            shift
        done
        $0 log $NEW_ARGS $([ "$APPLOG_FOLLOW" -eq 1 ] && echo '-f')
        ;;

    #查看命令审计日志
    audit)
        AUDIT_VIEW_FILE="$CDPC_LOGDIR/audit.log"
        if [ -f "$AUDIT_VIEW_FILE" ] ; then
            tail -n 100 "$AUDIT_VIEW_FILE"
        else
            echo "暂无审计日志。"
        fi
        ;;
    
    config)
        # 无参子命令：show / errors / list
        if [[ $# -gt 1 ]] ; then
            case $2 in
                show|errors|list)
                    handle_config $2
                    exit 0
                    ;;
            esac
        fi

        check_args2_exit $# 3
        handle_config $2 $3
        ;;

    #用户授权
    auth)
        if [[ $# -lt 2 ]] && [[ "$UID" -gt 0 ]] ; then
            if [ ! -f "/usr/local/cdpc/uauth/$ME" ] ; then
                echo "!!还没有被授权(You are not authorized.)"
            else
                echo "已被授权(You have be authorized.)"
            fi

            exit 0
        fi

        if [ "$UID" -gt 0 ] ; then
            echo "deny!!"
            exit 1
        fi

        if [ $# -lt 2 ] ; then
            UAUTH_PATH="/usr/local/cdpc/uauth"

            if [ ! -d "$UAUTH_PATH" ] ; then
                echo 'There is no user auth.'
            else
                ls $UAUTH_PATH
            fi

            exit 0
        fi

        #check_args2_exit $# 3

        #[add|remove] [USER]
        handle_auth $ARGS
        ;;

    help)
        help
        ;;
    
    'service-stop')
        if is_systemd ; then
            $SUDO systemctl stop cdpcd.service
        else
            $SUDO /etc/init.d/cdpc stop
        fi
        ;;

    'service-start')
        if is_systemd ; then
            $SUDO systemctl start cdpcd.service
        else
            $SUDO /etc/init.d/cdpc start
        fi
        ;;

    'service-restart')
        if is_systemd ; then
            $SUDO systemctl restart cdpcd.service
        else
            $SUDO /etc/init.d/cdpc restart
        fi
        ;;

    *)
        printf "\x1b[2;36m使用cdpc help查看帮助文档\n\x1b[0m"
        echo "快速使用提示："
        echo "  cdpc status 查看应用状态"
        echo "  cdpc inspect [应用名称] 查看服务完整运行时配置"
        echo "  cdpc config add [文件路径] 添加配置文件"
        echo "  cdpc config show 显示配置文件详情"
        echo "  cdpc config errors 查看最近一次配置加载报告"
        echo "  cdpc config remove [配置文件名称] 移除配置文件"
        echo "  cdpc start  [应用名称] 启动应用"
        echo "  cdpc stop   [应用名称] 停止应用"
        echo "  cdpc pause  [应用名称] 暂停应用"
        echo "  cdpc resume  [应用名称] 恢复暂停的应用"
        echo "  cdpc restart [应用名称] 重启应用"
        echo "  cdpc reload-force [应用名称...] 强制重载：停止后按配置文件重建（改了 env 等只在启动时读取的字段时用它）"
        echo "  cdpc log [应用名称] 查看应用日志（-f 持续跟踪，--clear 清理日志，--clear-all 清理全部含cdpcd日志）"
        echo "  cdpc auth 查看自己是否被授权/查看授权信息"
        echo "  cdpc service-start 启动cdpcd服务"
        echo "  cdpc service-stop 停止cdpcd服务"
        echo "  cdpc service-restart 重启cdpcd服务"
        echo "示例："
        echo "  cdpc stop --all"
        echo "  cdpc restart app1 app2"

        exit 0
        ;;
esac
